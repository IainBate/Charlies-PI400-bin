#!/bin/bash
#
# home_backup - back up PI400's own runtime secrets (SSH keys, deluge web
# UI auth, NetworkManager WiFi profiles) onto the Caravan drive, so
# fresh_install.sh has something to restore from if the SD card dies.
#
# This replaces an older version of this script that was a straight copy of
# HomePI4's home_backup - it referenced /mnt/HDD, /mnt/HDD_backup,
# /mnt/HDD_photos and ~/home_automation, none of which exist on this Pi, so
# it silently did nothing useful here. This version targets the one drive
# PI400 actually has: /media/pi/Caravan.
#
# Not currently scheduled by cron (see fresh_install.sh STEP 9) - run this
# by hand occasionally (e.g. whenever you've changed WiFi networks or reset
# the deluge password), or add it to a crontab.txt in this repo if you want
# it automatic.
#
set -e

BACKUP_DIR=/media/pi/Caravan/pi_config_backup

if ! mountpoint -q /media/pi/Caravan; then
	echo "ERROR: /media/pi/Caravan is not mounted - nothing to back up onto."
	exit 1
fi

mkdir -p "$BACKUP_DIR"/ssh "$BACKUP_DIR"/deluge "$BACKUP_DIR"/network-manager

echo "Backing up ~/.ssh..."
rsync --archive --delete /home/pi/.ssh/ "$BACKUP_DIR"/ssh/

echo "Backing up deluge web UI auth..."
if [ -f /home/pi/.config/deluge/auth ]; then
	cp /home/pi/.config/deluge/auth "$BACKUP_DIR"/deluge/auth
else
	echo "No ~/.config/deluge/auth found, skipping."
fi

echo "Backing up NetworkManager WiFi profiles (needs sudo to read them)..."
sudo rsync --archive --delete /etc/NetworkManager/system-connections/ "$BACKUP_DIR"/network-manager/
sudo chown -R pi:pi "$BACKUP_DIR"/network-manager

echo "Backup complete: $BACKUP_DIR"
